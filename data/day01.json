          { "q": "Toʻgʻri gap qaysi?", "o": ["I student.", "I am a student.", "Student I am."], "a": 1 },
          { "q": "\"Bekzod likes football.\" — FEʼL qaysi?", "o": ["Bekzod", "football", "likes"], "a": 2 },
