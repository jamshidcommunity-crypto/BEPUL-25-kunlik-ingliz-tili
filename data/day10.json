{
  "day": 10,
  "title": "Adverbs · some / any",
  "units": [
    {
      "id": 16,
      "code": "G",
      "title": "Adverbs (of manner + frequency)",
      "rule": "Ravish ish-harakat QANDAY yoki QANCHALIK TEZ-TEZ bajarilishini bildiradi. Holat ravishi sifatga *-ly* qoʻshib yasaladi: *slow → slowly, quick → quickly, careful → carefully*; istisno: *good → well, fast → fast, hard → hard*. Holat ravishi feʼldan keyin keladi: *Hamida walks slowly.* Takrorlanish ravishlari (*always, usually, often, sometimes, never*) asosiy feʼldan OLDIN, *be* feʼlidan esa KEYIN keladi: *I always get up early. Malika is never late.*",
      "examples": [
        "Bekzod runs quickly.",
        "Hamida walks slowly.",
        "Dilnoza speaks English well.",
        "I always get up at seven.",
        "Karim usually works in the garden.",
        "Malika is never late."
      ],
      "words": [
        { "en": "quickly", "uz": "tez" },
        { "en": "slowly", "uz": "sekin" },
        { "en": "carefully", "uz": "ehtiyotkorlik bilan" },
        { "en": "well", "uz": "yaxshi (ravish)" },
        { "en": "always", "uz": "har doim" },
        { "en": "usually", "uz": "odatda" },
        { "en": "sometimes", "uz": "baʼzan" },
        { "en": "never", "uz": "hech qachon" }
      ],
      "text": {
        "title": "Our mornings",
        "en": "Karim always gets up early. He works hard in the garden. Nodira usually gets up at six. She drives carefully to work. Bekzod often gets up late. He eats his breakfast quickly. Hamida walks slowly in the garden. Dilnoza sometimes goes to school by bus. She speaks English well. Tom the cat never gets up early. He sleeps all day!"
      },
      "exercises": {
        "choice": [
          { "q": "Hamida walks ___.", "o": ["slow", "slowly", "slows"], "a": 1 },
          { "q": "Toʻgʻri gap qaysi?", "o": ["Malika is never late.", "Malika is late never.", "Malika never is late."], "a": 0 },
          { "q": "Dilnoza speaks English ___.", "o": ["good", "nice", "well"], "a": 2 },
          { "q": "Toʻgʻri gap qaysi?", "o": ["I get always up early.", "I get up always early.", "I always get up early."], "a": 2 },
          { "q": "Bekzod runs ___.", "o": ["quick", "quickly", "quiet"], "a": 1 },
          { "q": "Hamida ___ drinks coffee. (0%)", "o": ["never", "always", "usually"], "a": 0 }
        ],
        "order": [
          { "w": ["slowly", "Hamida", "very", "walks"], "a": "Hamida walks very slowly." },
          { "w": ["up", "always", "I", "get", "early"], "a": "I always get up early." },
          { "w": ["English", "well", "Dilnoza", "speaks"], "a": "Dilnoza speaks English well." },
          { "w": ["never", "late", "is", "Karim"], "a": "Karim is never late." }
        ],
        "text": [
          { "q": "Karim always gets up early.", "o": ["True", "False"], "a": 0 },
          { "q": "Nodira drives ___.", "o": ["quickly", "carefully", "slowly"], "a": 1 },
          { "q": "Bekzod eats his breakfast slowly.", "o": ["True", "False"], "a": 1 },
          { "q": "Tom ___ gets up early.", "o": ["always", "sometimes", "never"], "a": 2 }
        ],
        "fill": [
          { "q": "Hamida walks ___.", "a": ["slowly"], "hint": "slow" },
          { "q": "Dilnoza speaks English ___.", "a": ["well"], "hint": "good" },
          { "q": "I ___ get up at seven.", "a": ["always"], "hint": "har doim (100%)" },
          { "q": "Nodira drives ___.", "a": ["carefully"], "hint": "careful" }
        ]
      },
