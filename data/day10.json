        "breakfast": "nonushta", "bus": "avtobus", "by bus": "avtobusda", "all day": "kun boʻyi", "drive": "haydamoq", "run": "yugurmoq",
        "walk": "yurmoq", "speak": "gapirmoq", "slowly": "sekin", "quickly": "tez", "carefully": "ehtiyotkorlik bilan", "well": "yaxshi (ravish)",
        "always": "har doim", "usually": "odatda", "often": "tez-tez", "sometimes": "baʼzan", "never": "hech qachon", "quiet": "jim",
        "quick": "tez", "slow": "sekin", "careful": "ehtiyotkor", "nice": "yoqimli, yaxshi", "good": "yaxshi", "work": "ishlamoq; ish",
