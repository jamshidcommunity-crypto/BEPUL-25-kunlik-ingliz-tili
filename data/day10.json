    {
      "id": 17,
      "code": "G",
      "title": "some / any",
      "rule": "*some* va *any* \"bir oz, bir nechta\" maʼnosini beradi. Ular koʻplikdagi otlar (*apples, eggs*) va sanalmaydigan otlar (*milk, bread, sugar*) bilan ishlatiladi. *some* — darak (tasdiq) gapda: *There is some milk. I have got some apples.* *any* — inkor va soʻroq gapda: *There isn't any milk. Is there any milk?*",
      "examples": [
        "There is some bread on the table.",
        "I have got some apples.",
        "There isn't any milk.",
        "We haven't got any eggs.",
        "Is there any sugar?",
        "Have you got any juice?"
      ],
      "words": [
        { "en": "some", "uz": "bir oz, bir nechta (+)" },
        { "en": "any", "uz": "hech; biror (−, ?)" },
        { "en": "bread", "uz": "non" },
        { "en": "milk", "uz": "sut" },
        { "en": "eggs", "uz": "tuxum" },
        { "en": "sugar", "uz": "shakar" },
        { "en": "juice", "uz": "sharbat" },
        { "en": "fridge", "uz": "muzlatgich" }
      ],
      "text": {
        "title": "In the kitchen",
        "en": "Nodira: Bekzod, is there any bread in the kitchen?\nBekzod: Yes, there is some bread on the table.\nNodira: Is there any milk in the fridge?\nBekzod: No, there isn't any milk. But there is some juice.\nNodira: Have we got any eggs?\nBekzod: Yes, we have got some eggs. And we have got some apples.\nNodira: Good. I want some tea now."
      },
      "exercises": {
        "choice": [
          { "q": "There is ___ milk in the fridge.", "o": ["some", "any", "a"], "a": 0 },
          { "q": "There isn't ___ sugar.", "o": ["some", "any", "an"], "a": 1 },
          { "q": "Is there ___ bread?", "o": ["a", "some", "any"], "a": 2 },
          { "q": "I have got ___ apples.", "o": ["any", "some", "an"], "a": 1 },
          { "q": "We haven't got ___ eggs.", "o": ["any", "some", "a"], "a": 0 },
          { "q": "Have you got ___ juice?", "o": ["some", "a", "any"], "a": 2 }
        ],
        "order": [
          { "w": ["is", "some", "there", "milk"], "a": "There is some milk." },
          { "w": ["any", "sugar", "is", "there"], "a": "Is there any sugar?" },
          { "w": ["got", "any", "we", "haven't", "eggs"], "a": "We haven't got any eggs." },
          { "w": ["tea", "I", "some", "want"], "a": "I want some tea." }
        ],
        "text": [
          { "q": "There is some bread on the table.", "o": ["True", "False"], "a": 0 },
          { "q": "There is some milk in the fridge.", "o": ["True", "False"], "a": 1 },
          { "q": "There is some ___.", "o": ["juice", "milk", "water"], "a": 0 },
          { "q": "Nodira wants some ___.", "o": ["coffee", "tea", "juice"], "a": 1 }
        ],
        "fill": [
