        { "en": "love", "uz": "sevmoq, yaxshi koʻrmoq" },
        { "en": "hate", "uz": "yomon koʻrmoq" },
        { "en": "enjoy", "uz": "zavqlanmoq, yoqtirmoq" },
        { "en": "get up", "uz": "turmoq (uyqudan)" }
      ],
      "text": {
